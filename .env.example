# Copy to .env and fill in. Never commit the real .env.

# --- Cloudflare (required for `engine_setup.py push`) ---
# API token with Zone:DNS:Edit on the zone below.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# --- Domain ---
PRIMARY_DOMAIN=example.com

# --- DKIM (published by your email provider; used by `verify`) ---
DKIM_VALUE=v=DKIM1; k=rsa; p=your_base64_public_key_here

# --- Custom open/click tracking CNAME ---
TRACKING_CNAME_TARGET=your-provider-tracking-host.example.net

# --- Lead research (scripts/run_gap_research.py) ---
OPENAI_API_KEY=sk-your_openai_key_here
PERPLEXITY_API_KEY=pplx-your_perplexity_key_here
# Models to query; override to whatever your account has access to.
#OPENAI_MODEL=gpt-4o
#PERPLEXITY_MODEL=sonar

# --- Optional overrides (defaults shown in comments) ---
# Selector queried as <selector>._domainkey.<PRIMARY_DOMAIN>   (default: default)
#DKIM_SELECTOR=default
# Hostname for the tracking CNAME, relative to PRIMARY_DOMAIN  (default: track)
#TRACKING_CNAME_NAME=track
# SPF record to publish. Set this — the fallback authorises no senders.
#SPF_VALUE=v=spf1 include:_spf.your-provider.com ~all
# DMARC record  (default: v=DMARC1; p=none; rua=mailto:dmarc@<PRIMARY_DOMAIN>; fo=1)
#DMARC_VALUE=v=DMARC1; p=none; rua=mailto:dmarc@example.com; fo=1
